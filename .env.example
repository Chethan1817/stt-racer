# Copy to .env and fill in the three API keys.
DEEPGRAM_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# Only needed for `dev`/`start` mode against a self-hosted server (`livekit-server --dev`).
# `console` mode needs none of these.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Everything below is optional; the values shown are the defaults.

# Engines to race, in priority order (used to break ties). Any of: deepgram, openai, groq
# STT_ENGINES=deepgram,openai,groq
# STT_LANGUAGE=en
# DEEPGRAM_STT_MODEL=nova-3
# OPENAI_STT_MODEL=gpt-4o-transcribe
# Context for the OpenAI model; without it an accented speaker sometimes gets transcribed
# in another script (Telugu, Japanese) even with STT_LANGUAGE set.
# OPENAI_STT_PROMPT=A person speaking English, possibly with an Indian or other non-native accent. Transcribe in English.
# GROQ_STT_MODEL=whisper-large-v3

# Per-engine deadline for one speech segment, in seconds.
# RACE_TIMEOUT_S=10
# Once a majority of engines have returned text, the rest get at most this long (bounds
# the slowest engine's tail). Set it empty to wait for every engine until RACE_TIMEOUT_S.
# RACE_GRACE_S=2
# Pause length that closes a speech segment for the race.
# SEGMENT_MIN_SILENCE_S=0.4

# LLM call #1: merges the engines' transcripts.
# gpt-4.1-mini is the fast default; gpt-5.5 was the most accurate in testing (~0.5 s slower).
# FUSION_LLM_MODEL=gpt-4.1-mini
# Set it empty for reasoning models (e.g. gpt-5.5), which reject temperature.
# FUSION_TEMPERATURE=0
# FUSION_TIMEOUT_S=15
# FUSION_CONTEXT_TURNS=6
# Comma-separated names or jargon the fusion step should prefer, e.g. "Toit,Indiranagar,LiveKit"
# FUSION_KEYTERMS=
# Off by default: the task calls for the LLM pass on every turn. Set true to skip the
# call when every engine returned the same words (saves ~1 s on those turns; ignored when
# FUSION_KEYTERMS is set).
# FUSION_SKIP_IF_UNANIMOUS=false

# LLM call #2 (the reply) and the voice.
# AGENT_LLM_MODEL=gpt-4.1-mini
# TTS_MODEL=aura-2-andromeda-en

# eou = local end-of-turn model (recommended); vad = silence-based only.
# TURN_DETECTION=eou
# LOG_DIR=logs
